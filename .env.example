# AI Provider: deepseek, groq, or openai
AI_PROVIDER=deepseek

# DeepSeek API Key (get from https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq API Key (optional - only if using groq provider)
# GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional - only if using openai provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (get from https://supabase.com/dashboard)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# CORS Origins (comma-separated, for production)
ALLOWED_ORIGINS=http://localhost:3000,https://your-lovable-site.com
